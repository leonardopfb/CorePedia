# ===== Obrigatórias =====
# Gere com: openssl rand -base64 33
AUTH_SECRET=

# Endereço público da aplicação (domínio de produção, com https)
AUTH_URL=https://repasse.seudominio.com.br

# ===== Login corporativo: Microsoft Entra ID (recomendado) =====
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Use o ID do diretório (tenant) do banco. NÃO use /common, /organizations nem /consumers.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<ID-DO-TENANT>/v2.0

# ===== Login alternativo: Google (opcional) =====
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== Quem pode entrar (separe por vírgula) =====
# Sem nenhuma lista preenchida, ninguém entra.
ADMIN_EMAILS=
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
BLOCKED_EMAILS=

# Contato exibido na tela "Acesso não autorizado"
ACCESS_CONTACT=

# ===== Pré-cadastro (pedido de acesso com aprovação do administrador) =====
# Precisa de um Redis (Upstash, pelo Marketplace da Vercel). As variáveis abaixo são criadas pela integração.
# Aceitamos os dois nomes: UPSTASH_REDIS_REST_* ou KV_REST_API_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# off desliga o pré-cadastro (o acesso passa a depender só das listas acima)
SELF_REGISTRATION=on
# Opcional: limita quem pode pedir acesso a estes domínios. Obrigatório se usar Google.
REGISTRATION_DOMAINS=
# Opcional: webhook (Teams via Workflows, Slack...) que recebe {"text": "..."} a cada novo pedido
NOTIFY_WEBHOOK_URL=
# Segundos de cache da checagem de aprovação (retirar um acesso vale em até este tempo). Padrão: 5
ACCESS_CACHE_SECONDS=5

# ===== Cadastro aberto com e-mail e senha (qualquer e-mail; o administrador aprova) =====
# on (padrão) ou off. Precisa do Redis acima e do envio de e-mail abaixo.
CADASTRO_ABERTO=on
# Envio dos e-mails de confirmação e redefinição de senha (Resend). Sem isto, em produção o cadastro fica fechado.
RESEND_API_KEY=
MAIL_FROM="CorePédia <acesso@seudominio.com.br>"
# Opcional: provedores de e-mail descartáveis que não podem se cadastrar (separe por vírgula)
CADASTRO_DOMINIOS_BLOQUEADOS=

# ===== Assistente (agente que responde com base nos Markdown) =====
ANTHROPIC_API_KEY=
# Padrão: claude-sonnet-5-5. Para custo menor, claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Perguntas por pessoa por hora
AGENT_LIMIT_PER_HOUR=30

# ===== Opcional: gerenciar acessos sem novo deploy (Vercel Global Config, antigo Edge Config) =====
# Preenchida automaticamente pela Vercel ao conectar o Global Config ao projeto.
GLOBAL_CONFIG=

# ===== Somente desenvolvimento local (ignorado em produção) =====
DEV_LOGIN_ENABLED=false
